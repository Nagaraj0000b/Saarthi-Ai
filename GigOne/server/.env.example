# Copy this file to `.env` before running:
# Windows (PowerShell/CMD): copy .env.example .env
# macOS/Linux: cp .env.example .env

# Required
MONGO_URI=mongodb://127.0.0.1:27017/project_db
JWT_SECRET=replace_with_a_long_random_secret

# Optional
PORT=5000
CLIENT_URL=http://localhost:5173
ML_API_URL=http://127.0.0.1:8000
CHAT_TURN_URL=http://127.0.0.1:8000/chat/turn
CHAT_TURN_TIMEOUT_MS=60000
JWT_PEPPER=

# Optional integrations
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=

# Compatibility for helper scripts
MONGODB_URI=mongodb://127.0.0.1:27017/project_db
